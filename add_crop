{% extends "baseofhtml.html" %}

{% block title %}
Add Crop
{% endblock %}

{% block content %}

<div style="max-width:600px;margin:40px auto;padding:25px;background:white;border-radius:20px;">

    <h2>🌱 Add New Crop</h2>

    {% if error %}
        <p style="color:red;">{{ error }}</p>
    {% endif %}

    <form method="POST">

        <label>Crop Name</label>
        <input
            type="text"
            name="crop_name"
            placeholder="Enter crop name"
            required
            style="width:100%;padding:12px;margin:8px 0 15px;"
        >

        <label>Crop Type</label>
        <input
            type="text"
            name="crop_type"
            placeholder="Example: Kharif / Rabi"
            style="width:100%;padding:12px;margin:8px 0 15px;"
        >

        <label>Sowing Date</label>
        <input
            type="date"
            name="sowing_date"
            style="width:100%;padding:12px;margin:8px 0 20px;"
        >

        <button
            type="submit"
            style="padding:12px 25px;border:0;border-radius:10px;background:#7b2cbf;color:white;"
        >
            🌱 Add Crop
        </button>

    </form>

</div>

{% endblock %}